# ---------- Mode ----------
# Demo: MOCK=1 (default). Sample data, nothing paid, open to everyone.
# Test: MOCK=0 and SANDBOX=1. Real Sui + X data (X paid with free test USDC on Celo Sepolia). Open to everyone.
# Live: MOCK=0 and SANDBOX=0. Everything real; after the free scans, scanning needs LOFI.
MOCK=1
SANDBOX=0

# 64 random hex characters (openssl rand -hex 32). Signs the free-scan and holder cookies and the summary token.
SESSION_SECRET=

# ---------- Hold to scan ----------
# Free scans per visitor before a LOFI wallet is needed, and a daily ceiling on free scans
FREE_CHECKS=2
FREE_DAILY_LIMIT=300
# A wallet must hold this many USD of LOFI (priced from its deepest pool)
HOLD_USD=1
# Scans per day for a LOFI holder
HOLDER_DAILY_SCANS=20
# Used only if no LOFI price can be read
HOLD_FALLBACK_LOFI=150
# Optional CoinGecko key (free demo key works) for the centralised-exchange volume line
# COINGECKO_API_KEY=
# LOFI_COIN_TYPE=0xf22da9a24ad027cccb5f2d496cbe91de953d363513db08a3a734d361c7c17503::LOFI::LOFI

# ---------- Sui reads ----------
# SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
# Pages of 50 recent pool transactions to read per scan
SWAP_PAGES=4

# ---------- X data + AI summary (paid through buy on Celo, same as traction-check) ----------
AGENT_PRIVATE_KEY=
AGENT_PAY_TOKEN=USDC
SANDBOX_PRIVATE_KEY=
DAILY_SPEND_CAP=3
MAX_X_SEARCH=0.02
MAX_LLM=0.02

# ---------- Publishing each report on Sui + Walrus ----------
# testnet (free) or mainnet
PUBLISH_NETWORK=testnet
# From `sui client publish` of the move/ package (see README)
SCOUT_PACKAGE_ID=
SCOUT_OBJECT_ID=
SCOUT_ADMIN_CAP_ID=
# suiprivkey... of the wallet that owns the AdminCap (npm run wallet makes a fresh one)
PUBLISHER_PRIVATE_KEY=
# Walrus. Testnet has a free public publisher. Mainnet needs your own publisher URL.
# WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
# WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5
